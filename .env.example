# The port the app listens on, for both `npm run dev` and `npm start`.
# Defaults to 3004. A PORT set in the real environment takes precedence.
PORT=3004

# The PAJ API (main_backend). The server render and the browser both use it,
# and its origin is the only one the page's CSP lets it connect to. Read at
# build time: change it, then rebuild.
NEXT_PUBLIC_API_URL=http://localhost:3000
